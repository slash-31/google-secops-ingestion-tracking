# ==============================================================================
# Google SecOps Ingestion Intelligence — Environment Configuration (.env)
# ==============================================================================
# QUICK START:
#   1. Copy this template to `.env`:
#        cp .env.example .env
#   2. Lock down file permissions so only your user can read it:
#        chmod 600 .env
#   3. Replace the placeholder values below with your own project ID, API keys,
#      and tokens.
#   4. The application (`app.py`, `secops_ingestion_cli.py`, and Gunicorn)
#      automatically loads `.env` at startup — no Secret Manager required.
#      For Docker, pass `--env-file .env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE SECOPS / CLOUD MONITORING CONFIGURATION
# ------------------------------------------------------------------------------

# Your Google Cloud Project ID where Google SecOps (Chronicle) is bound.
# Example: SECOPS_PROJECT_ID="acme-secops-prod-12345"
SECOPS_PROJECT_ID="your-secops-project-id"

# Authentication Option A (Recommended outside GCP):
# Absolute or relative path to your GCP Service Account JSON key file with
# the `roles/monitoring.viewer` IAM role.
# Leave blank if using `gcloud auth application-default login` or an attached
# VM/Cloud Run service account.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/credentials.json"

# Authentication Option B (Short-lived Bearer Token):
# Optional OAuth2 access token (e.g., from `gcloud auth print-access-token`).
# Leave empty when using GOOGLE_APPLICATION_CREDENTIALS or ADC.
GCP_ACCESS_TOKEN=""

# Synthetic / Demo Mode:
# Set to "true" to run offline with realistic synthetic telemetry (no GCP or
# BindPlane credentials required). Set to "false" for live production data.
MOCK_MODE="false"

# Fallback Behavior on Cloud Monitoring Outage:
# Keep "false" in production so auth/API errors surface clearly instead of
# silently displaying synthetic data.
ALLOW_MOCK_FALLBACK="false"

# ------------------------------------------------------------------------------
# 2. BINDPLANE CLOUD / OPAMP COLLECTOR TELEMETRY (OPTIONAL)
# ------------------------------------------------------------------------------
# Enables the Pipeline Health, BindPlane Collectors, Delivery Reconciliation,
# and Unified by Log Type panels. Leave blank if you do not use BindPlane.

# Your 26-character BindPlane Account / Project ULID
# (Found in BindPlane UI -> Project Settings -> Account ID).
BINDPLANE_ACCOUNT_ID="01XXXXXXXXXXXXXXXXXXXXXXXX"

# Your BindPlane REST/GraphQL API Key
# (Found in BindPlane UI -> Profile / API Keys -> Create API Key).
BINDPLANE_API_KEY="bp_api_key_replace_with_your_actual_key"

# Optional: Instead of placing the raw key in BINDPLANE_API_KEY above, you can
# point to a local file containing the single-line API key:
BINDPLANE_API_KEY_FILE=""

# BindPlane Server URL (defaults to BindPlane Cloud; must use https://)
BINDPLANE_BASE_URL="https://app.bindplane.com"

# Comma-separated SecOps collector_id(s) that identify BindPlane Chronicle
# exporter traffic in Cloud Monitoring:
BINDPLANE_SECOPS_COLLECTOR_IDS="aaaa1111-aaaa-1111-aaaa-1111aaaa1112"

# ------------------------------------------------------------------------------
# 3. APPLICATION SECURITY TOKENS (ADMIN & CRON ENDPOINTS)
# ------------------------------------------------------------------------------
# Mutating POST endpoints are deny-by-default (HTTP 503) until these tokens are
# set. Generate strong random tokens using:
#   openssl rand -hex 32

# Token required to call `POST /api/settings` and `POST /api/refresh`
# Pass via header: `Authorization: Bearer <ADMIN_SECRET>` or `X-Auth-Token: <ADMIN_SECRET>`
ADMIN_SECRET="replace-with-random-hex-token-from-openssl-rand-hex-32"

# Token required to call `POST /api/collect` (scheduled telemetry collection)
# Pass via header: `Authorization: Bearer <CRON_SECRET>` or `X-Cron-Token: <CRON_SECRET>`
CRON_SECRET="replace-with-random-hex-token-from-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# 4. WEB SERVER & SSL/TLS SETTINGS
# ------------------------------------------------------------------------------

# Bind address (`0.0.0.0` for containers/VMs, `127.0.0.1` for local-only dev)
HOST="0.0.0.0"

# Listener port (`8443` in Docker, `5000` or `8080` for local HTTP, `443` for HTTPS)
PORT="8080"

# Set to "true" to enable built-in HTTPS using the certificate/key below
SSL_ENABLED="false"
SSL_CERT_PATH="certs/cert.pem"
SSL_KEY_PATH="certs/key.pem"

# Rate-limit client identification behind proxies (prevents header spoofing).
# Number of right-most X-Forwarded-For entries appended by YOUR infrastructure:
#   1 = Cloud Run or a single reverse proxy (default)
#   2 = Google Cloud external Application Load Balancer
#   0 = no proxy; ignore X-Forwarded-For and use the socket address
TRUSTED_PROXY_HOPS="1"
# Only set "true" if the origin accepts traffic exclusively from Cloudflare;
# otherwise CF-Connecting-IP is forgeable by any client.
TRUST_CLOUDFLARE="false"

# ------------------------------------------------------------------------------
# 5. PIPELINE HEALTH & DELIVERY RECONCILIATION THRESHOLDS (OPTIONAL TUNING)
# ------------------------------------------------------------------------------

# Collector source-to-destination drop warning / critical thresholds (%)
PIPELINE_DROP_WARN_PCT="20"
PIPELINE_DROP_CRIT_PCT="50"
PIPELINE_DROP_MIN_INPUT_BPS="100"
PIPELINE_SILENT_BPS="0"

# SecOps log-type silence detection thresholds
SECOPS_SILENT_AFTER_MINUTES="90"
SECOPS_SILENT_CADENCE_MULTIPLIER="3"
SECOPS_SILENT_MIN_BUCKETS="4"
SECOPS_SILENT_IGNORE_LOG_TYPES=""

# BindPlane -> SecOps delivery gap thresholds (%)
DELIVERY_GAP_WARN_PCT="50"
DELIVERY_GAP_CRIT_PCT="80"
DELIVERY_BASELINE_OUTLIER_PCT="75"
DELIVERY_MIN_BYTES="1000000"
